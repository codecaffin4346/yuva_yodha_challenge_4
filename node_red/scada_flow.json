[
    {
        "id": "tab_scada_flow",
        "type": "tab",
        "label": "Yuva Yodha SCADA Pipeline",
        "disabled": false,
        "info": "Node-RED telemetry pipeline for Smart Industrial Monitoring (Challenge 4)"
    },
    {
        "id": "mqtt_in_telemetry",
        "type": "mqtt in",
        "z": "tab_scada_flow",
        "name": "MQTT Ingest (sensors/scada/telemetry)",
        "topic": "sensors/scada/telemetry",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 210,
        "y": 140,
        "wires": [["json_parser"]]
    },
    {
        "id": "json_parser",
        "type": "json",
        "z": "tab_scada_flow",
        "name": "Parse Telemetry Payload",
        "property": "payload",
        "action": "",
        "pretty": false,
        "x": 450,
        "y": 140,
        "wires": [["threshold_evaluator", "influxdb_formatter"]]
    },
    {
        "id": "threshold_evaluator",
        "type": "function",
        "z": "tab_scada_flow",
        "name": "Evaluate Thermal Safety Thresholds",
        "func": "const procTemp = msg.payload.ProcTemp;\nif (procTemp > 75.0) {\n    return [\n        { payload: \"FAN_ON\", topic: \"sensors/scada/control\" },\n        { payload: `WARNING: High Process Temp Detected (${procTemp}°C)` }\n    ];\n} else if (procTemp < 45.0) {\n    return [\n        { payload: \"HEATER_ON\", topic: \"sensors/scada/control\" },\n        null\n    ];\n}\nreturn [null, null];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 730,
        "y": 140,
        "wires": [
            ["mqtt_out_control"],
            ["debug_alerts"]
        ]
    },
    {
        "id": "mqtt_out_control",
        "type": "mqtt out",
        "z": "tab_scada_flow",
        "name": "MQTT Control Actuator",
        "topic": "sensors/scada/control",
        "qos": "0",
        "retain": "false",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "mqtt_broker_local",
        "x": 1030,
        "y": 120,
        "wires": []
    },
    {
        "id": "debug_alerts",
        "type": "debug",
        "z": "tab_scada_flow",
        "name": "Alarm Notification Console",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 1040,
        "y": 180,
        "wires": []
    },
    {
        "id": "influxdb_formatter",
        "type": "function",
        "z": "tab_scada_flow",
        "name": "Format for InfluxDB Write",
        "func": "msg.payload = [\n    {\n        measurement: \"scada_telemetry\",\n        fields: {\n            ProcTemp: msg.payload.ProcTemp,\n            EnvTemp: msg.payload.EnvTemp,\n            Current: msg.payload.Current\n        },\n        tags: {\n            location: \"factory_floor_line_1\"\n        }\n    }\n];\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 240,
        "wires": [["debug_influx"]]
    },
    {
        "id": "debug_influx",
        "type": "debug",
        "z": "tab_scada_flow",
        "name": "InfluxDB Logger Payload",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 970,
        "y": 240,
        "wires": []
    },
    {
        "id": "mqtt_broker_local",
        "type": "mqtt-broker",
        "name": "Raspberry Pi Local MQTT",
        "broker": "172.20.10.7",
        "port": "1883",
        "clientid": "NodeRED_Edge_Server",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true
    }
]
